{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TARL train",
            "type": "debugpy",
            "request": "launch",
            "program": "tarl/tarl_train.py",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--config",
                "tarl/config/debug.yaml"
            ]
        },

        {
            "name": "TARL DDP",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1",
                // "NCCL_P2P_DISABLE": "1"
            },
            "args": [
                "--nproc_per_node=2",
                "--master_port", "20000",
                "-m", "tarl.tarl_ddptrain",
                "--config",
                "tarl/config/config_ddp.yaml"
            ],
            "justMyCode": true
        }
    ]
}